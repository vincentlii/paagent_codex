# Shared, non-secret Codex runtime identity. Both PA Agent and the isolated
# pa-agent-codex worker read this file; no DeepSeek credential belongs here.
PA_AGENT_CODEX_ENABLED=0
PA_AGENT_CODEX_MODEL=
PA_AGENT_CODEX_REASONING=high
PA_AGENT_CODEX_BINARY=/usr/local/bin/codex
PA_AGENT_CODEX_STATE_DIR=/var/lib/pa-agent-codex
PA_AGENT_CODEX_MAX_WORKERS=1
# Only for the engineering-only deepseek-flash Codex provider; leave empty for ChatGPT models.
PA_AGENT_CODEX_MODEL_CATALOG=
